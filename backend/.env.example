DATABASE_URL=postgres://postgres:postgres@localhost:5432/talentflow_ai
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
UPLOAD_ROOT=uploads
MAX_RESUME_SIZE_BYTES=10485760
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_MAX_RETRIES=3
CELERY_RETRY_BACKOFF_SECONDS=5

# --- Authentication ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Set to true when the site is served over HTTPS.
SESSION_COOKIE_SECURE=false
# Optional private login created by the seed script (not shown anywhere in the UI).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Demo mode --------------------------------------------------------------------
# Enables the one-click demo login, demo banner, and nightly data reset.
DEMO_MODE=true
DEMO_RECRUITER_EMAIL=demo@northstar.example.com
DEMO_RECRUITER_PASSWORD=demo-recruiter
DEMO_RESET_HOUR_UTC=3

# --- Cost and abuse protection ----------------------------------------------------
REDIS_URL=redis://localhost:6379/2
# Maximum OpenAI requests per UTC day across the whole app (0 disables the cap).
AI_DAILY_CALL_LIMIT=200
APPLICATION_RATE_LIMIT_PER_HOUR=3
LOGIN_RATE_LIMIT_PER_WINDOW=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
COMPARISON_CACHE_SECONDS=86400
RESUME_TEXT_MAX_CHARS=20000
AI_MAX_OUTPUT_TOKENS=6000
# Leave unset to enable the GraphQL IDE in development and disable it in production.
# GRAPHQL_IDE_ENABLED=
