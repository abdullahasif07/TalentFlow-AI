NEXT_PUBLIC_GRAPHQL_URL=http://localhost:8000/graphql
NEXT_PUBLIC_MAX_RESUME_SIZE_MB=10
# Optional; defaults to NEXT_PUBLIC_GRAPHQL_URL without /graphql.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Production (set these in Vercel, see DEPLOYMENT.md) ---------------------------
# Route API calls through this site (frontend/proxy.ts) so the session cookie is
# first-party:
#   NEXT_PUBLIC_GRAPHQL_URL=/backend/graphql
#   NEXT_PUBLIC_MAX_RESUME_SIZE_MB=4
#   BACKEND_ORIGIN=https://<your-server-ip-with-dashes>.sslip.io
#   PROXY_SHARED_SECRET=<same value as PROXY_SHARED_SECRET on the server>
