# Copy to deploy/.env.production on the server and fill in every <...> value.
# Generate secrets with:  openssl rand -hex 32

# --- Server -----------------------------------------------------------------------
# Your server's public IP with dots replaced by dashes, plus .sslip.io
API_HOST=<1-2-3-4>.sslip.io
POSTGRES_PASSWORD=<openssl rand -hex 24>

# --- App --------------------------------------------------------------------------
APP_ENV=production
# Your Vercel URL (no trailing slash).
CORS_ORIGINS=["https://<your-project>.vercel.app"]
SESSION_SECRET=<openssl rand -hex 32>
SESSION_COOKIE_SECURE=true
# Must match PROXY_SHARED_SECRET in Vercel. With it set, the API answers only
# requests that came through the frontend.
PROXY_SHARED_SECRET=<openssl rand -hex 32>

OPENAI_API_KEY=<sk-...>
OPENAI_MODEL=gpt-4.1-mini

# Optional private login for yourself (created by the seed script).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Demo mode --------------------------------------------------------------------
DEMO_MODE=true
DEMO_RESET_HOUR_UTC=3

# --- Cost and abuse protection ----------------------------------------------------
# Total OpenAI requests per UTC day for the whole site.
AI_DAILY_CALL_LIMIT=50
APPLICATION_RATE_LIMIT_PER_HOUR=3
LOGIN_RATE_LIMIT_PER_WINDOW=10
# Keep in step with NEXT_PUBLIC_MAX_RESUME_SIZE_MB=4 in Vercel (the proxy limit).
MAX_RESUME_SIZE_BYTES=4194304
